<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.microsoft.multiclouddb</groupId>
        <artifactId>multiclouddb-sdk-java-parent</artifactId>
        <version>1-SNAPSHOT</version>
    </parent>

    <artifactId>multiclouddb-provider-cosmos</artifactId>
    <version>${multiclouddb-provider-cosmos.version}</version>
    <name>Multicloud DB Cosmos DB Provider</name>
    <description>Azure Cosmos DB provider adapter for Multicloud DB SDK</description>
    <url>https://github.com/microsoft/multiclouddb-sdk-for-java</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/microsoft/multiclouddb-sdk-for-java</url>
        <connection>scm:git:https://github.com/microsoft/multiclouddb-sdk-for-java.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/microsoft/multiclouddb-sdk-for-java.git</developerConnection>
    </scm>

    <developers>
        <developer>
            <id>microsoft</id>
            <name>Microsoft Corporation</name>
            <url>https://github.com/microsoft</url>
        </developer>
    </developers>

    <dependencies>
        <dependency>
            <groupId>com.microsoft.multiclouddb</groupId>
            <artifactId>multiclouddb-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-cosmos</artifactId>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Shared native bindings for the checked v4 graph, not arbitrary-version isolation. -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.13.0</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.17.0</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>CHANGELOG.md</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>cosmos-runtime-classpath</id>
                        <phase>prepare-package</phase>
                        <goals><goal>build-classpath</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputProperty>cosmos.runtime.classpath</outputProperty>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <createDependencyReducedPom>true</createDependencyReducedPom>
                    <useDependencyReducedPomInJar>true</useDependencyReducedPomInJar>
                    <minimizeJar>false</minimizeJar>
                    <artifactSet>
                        <excludes>
                            <exclude>com.microsoft.multiclouddb:multiclouddb-api</exclude>
                            <exclude>org.slf4j:*</exclude>
                            <exclude>com.google.code.gson:gson</exclude>
                            <exclude>com.google.errorprone:error_prone_annotations</exclude>
                            <exclude>net.java.dev.jna:*</exclude>
                        </excludes>
                    </artifactSet>
                    <!-- Replaced by the explicit descriptor below, not an automatic module. -->
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>module-info.class</exclude>
                                <exclude>META-INF/versions/**/module-info.class</exclude>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                            </excludes>
                        </filter>
                    </filters>
                    <relocations>
                        <relocation><pattern>com.azure</pattern><shadedPattern>com.multiclouddb.provider.cosmos.shaded.com.azure</shadedPattern></relocation>
                        <relocation><pattern>com.fasterxml</pattern><shadedPattern>com.multiclouddb.provider.cosmos.shaded.com.fasterxml</shadedPattern></relocation>
                        <relocation><pattern>io.netty</pattern><shadedPattern>com.multiclouddb.provider.cosmos.shaded.io.netty</shadedPattern></relocation>
                        <relocation><pattern>reactor</pattern><shadedPattern>com.multiclouddb.provider.cosmos.shaded.reactor</shadedPattern></relocation>
                        <relocation><pattern>org.reactivestreams</pattern><shadedPattern>com.multiclouddb.provider.cosmos.shaded.org.reactivestreams</shadedPattern></relocation>
                        <relocation><pattern>com.microsoft.aad</pattern><shadedPattern>com.multiclouddb.provider.cosmos.shaded.com.microsoft.aad</shadedPattern></relocation>
                        <relocation><pattern>com.microsoft.msal</pattern><shadedPattern>com.multiclouddb.provider.cosmos.shaded.com.microsoft.msal</shadedPattern></relocation>
                        <relocation><pattern>io.micrometer</pattern><shadedPattern>com.multiclouddb.provider.cosmos.shaded.io.micrometer</shadedPattern></relocation>
                        <relocation><pattern>com.codahale</pattern><shadedPattern>com.multiclouddb.provider.cosmos.shaded.com.codahale</shadedPattern></relocation>
                        <relocation><pattern>org.HdrHistogram</pattern><shadedPattern>com.multiclouddb.provider.cosmos.shaded.org.HdrHistogram</shadedPattern></relocation>
                        <relocation><pattern>org.LatencyUtils</pattern><shadedPattern>com.multiclouddb.provider.cosmos.shaded.org.LatencyUtils</shadedPattern></relocation>
                    </relocations>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/io.netty.versions.properties</resource>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <manifestEntries><Multi-Release>true</Multi-Release></manifestEntries>
                        </transformer>
                    </transformers>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.8</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>preserve-cosmos-resources</id>
                        <phase>prepare-package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/packaging-tools"/>
                                <javac srcdir="${project.basedir}/src/build/java"
                                       destdir="${project.build.directory}/packaging-tools"
                                       release="17" includeantruntime="false">
                                    <classpath refid="maven.plugin.classpath"/>
                                </javac>
                                <java classname="com.multiclouddb.build.CosmosPackage" fork="true" failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/packaging-tools"/>
                                        <path refid="maven.plugin.classpath"/>
                                    </classpath>
                                    <arg value="prepare"/>
                                    <arg value="${project.build.outputDirectory}"/>
                                    <arg value="${cosmos.runtime.classpath}"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>finalize-cosmos-module</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <java classname="com.multiclouddb.build.CosmosPackage" fork="true" failonerror="true">
                                    <classpath>
                                        <pathelement location="${project.build.directory}/packaging-tools"/>
                                        <path refid="maven.plugin.classpath"/>
                                    </classpath>
                                    <arg value="finish"/>
                                    <arg value="${project.build.directory}/${project.build.finalName}.jar"/>
                                </java>
                                <mkdir dir="${project.build.directory}/packaged-descriptor"/>
                                <javac srcdir="${project.basedir}/src/build/module"
                                       destdir="${project.build.directory}/packaged-descriptor"
                                       release="17" includeantruntime="false" fork="true">
                                    <compilerarg value="--module-path"/>
                                    <compilerarg value="${cosmos.runtime.classpath}"/>
                                    <compilerarg value="--patch-module"/>
                                    <compilerarg value="com.multiclouddb.provider.cosmos=${project.build.directory}/${project.build.finalName}.jar"/>
                                </javac>
                                <exec executable="${java.home}/bin/jar" failonerror="true">
                                    <arg value="--update"/>
                                    <arg value="--file"/>
                                    <arg value="${project.build.directory}/${project.build.finalName}.jar"/>
                                    <arg value="-C"/>
                                    <arg value="${project.build.directory}/packaged-descriptor"/>
                                    <arg value="module-info.class"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Byte Buddy (used by Mockito) does not officially support
                         Java versions beyond 22. Enable experimental mode so that
                         CosmosException (and other Azure SDK exception classes)
                         can be mocked on Java 23+.
                         Run in classpath mode (not module path) so that Netty 4.2.x
                         split-module issues are avoided: netty-codec-compression
                         requires "io.netty.codec" but netty-codec 4.2.x exports the
                         module as "io.netty.codec.unused", causing resolution failures
                         when both are on the module path. -->
                    <useModulePath>false</useModulePath>
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>prepare-package</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
