# Copy to dynamo.live.properties (gitignored) and fill in LIVE account values.
multiclouddb.provider=dynamo
multiclouddb.connection.region=us-east-1
# Prefer an IAM role / default credential chain over static keys where possible.
multiclouddb.auth.accessKeyId=<access-key-id>
multiclouddb.auth.secretAccessKey=<secret-access-key>
multiclouddb.connection.requestTimeoutSeconds=30
multiclouddb.database=perfdb
multiclouddb.collection=perf

# Fair-comparison metadata.
multiclouddb.region=us-east-1
# Optional cross-cloud colocation label used by --region-policy warn|fail.
multiclouddb.comparisonRegion=
# Optional display value; the harness probes actual billing mode / RCU / WCU from DescribeTable.
multiclouddb.provisionedCapacity=PAY_PER_REQUEST or PROVISIONED rcu=... wcu=...
multiclouddb.sdkVersion=dev
